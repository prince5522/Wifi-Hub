rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User profiles: users can read/update their own safe profile fields.
    // Admin operations must be handled deliberately and audited.
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Saved network metadata belongs to its owner.
    match /networks/{networkId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow update: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Invitations are controlled by server-side logic.
    match /invitations/{inviteId} {
      allow read: if signedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isAdmin() ||
        (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Payment records must be written by trusted server code.
    match /payments/{paymentId} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Subscription/pro access is server-authoritative.
    match /entitlements/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }
  }
}
